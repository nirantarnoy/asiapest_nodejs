<%- include('../partials/layout_start') %>

    <form action="/quotations/edit/<%= item.id %>" method="POST" id="mainForm" class="max-w-7xl mx-auto pb-20">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">แก้ไขใบเสนอราคา</h1>
                <p class="text-slate-500 mt-1 font-medium">จัดการข้อมูใบเสนอราคาให้ลูกค้าในระบบ</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/quotations/job-details/<%= item.id %>"
                    class="flex items-center justify-center space-x-1.5 bg-indigo-50 border border-indigo-100 text-indigo-600 hover:bg-indigo-100 px-4 py-2 rounded-xl shadow-sm transition-all font-bold text-sm">
                    <i class="fa-solid fa-list-check"></i>
                    <span>รายละเอียดงาน</span>
                </a>
                <a href="/quotations/print-job/<%= item.id %>" target="_blank"
                    class="flex items-center justify-center space-x-1.5 bg-slate-100 border border-slate-200 text-slate-600 hover:bg-slate-200 px-4 py-2 rounded-xl shadow-sm transition-all font-bold text-sm">
                    <i class="fa-solid fa-file-invoice"></i>
                    <span>พิมพ์งาน</span>
                </a>
                <a href="/quotations/print/<%= item.id %>" target="_blank"
                    class="flex items-center justify-center space-x-1.5 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl shadow-lg shadow-blue-200 transition-all active:scale-95 font-bold text-sm">
                    <i class="fa-solid fa-print"></i>
                    <span>พิมพ์ใบเสนอราคา</span>
                </a>

                <% if (item.status==1) { %>
                    <a href="/quotations/approve/<%= item.id %>"
                        class="flex items-center justify-center space-x-1.5 bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-xl shadow-lg shadow-amber-200 transition-all font-bold text-sm">
                        <i class="fa-solid fa-check-double"></i>
                        <span>อนุมัติ</span>
                    </a>
                    <% } %>

                        <% if (item.status==2) { %>
                            <% if (typeof contract !=='undefined' && contract) { %>
                                <a href="/contracts/edit/<%= contract.id %>"
                                    class="flex items-center justify-center space-x-1.5 bg-slate-800 hover:bg-slate-900 text-white px-4 py-2 rounded-xl shadow-lg transition-all font-bold text-sm">
                                    <i class="fa-solid fa-file-signature"></i>
                                    <span>ดูสัญญา</span>
                                </a>
                                <% } else { %>
                                    <a href="/quotations/create-contract/<%= item.id %>"
                                        class="flex items-center justify-center space-x-1.5 bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-xl shadow-lg shadow-purple-200 transition-all font-bold text-sm">
                                        <i class="fa-solid fa-file-contract"></i>
                                        <span>สร้างสัญญา</span>
                                    </a>
                                    <% } %>
                                        <% } %>

                                            <% if (item.status==3) { %>
                                                <% if (typeof contract !=='undefined' && contract) { %>
                                                    <a href="/contracts/edit/<%= contract.id %>"
                                                        class="flex items-center justify-center space-x-1.5 bg-slate-800 hover:bg-slate-900 text-white px-4 py-2 rounded-xl shadow-lg transition-all font-bold text-sm">
                                                        <i class="fa-solid fa-file-signature"></i>
                                                        <span>ดูสัญญา</span>
                                                    </a>
                                                    <% } %>
                                                        <a href="/quotations/create-plan/<%= item.id %>"
                                                            class="flex items-center justify-center space-x-1.5 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-xl shadow-lg shadow-cyan-200 transition-all font-bold text-sm">
                                                            <i class="fa-solid fa-calendar-check"></i>
                                                            <span>สร้างแผนงาน</span>
                                                        </a>
                                                        <% } %>

                                                            <button type="submit"
                                                                class="flex items-center justify-center space-x-1.5 bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-xl shadow-lg shadow-emerald-200 transition-all active:scale-95 font-bold text-sm">
                                                                <i class="fa-solid fa-save"></i>
                                                                <span>บันทึก</span>
                                                            </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Header Info -->
            <div class="lg:col-span-12 space-y-6">
                <div
                    class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 p-8 grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">เลขที่ใบเสนอราคา</label>
                        <input type="text" name="quotation_no" required value="<%= item.quotation_no %>"
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">วันที่เอกสาร</label>
                        <input type="date" name="quotation_date" required
                            value="<%= item.quotation_date ? new Date(item.quotation_date).toISOString().split('T')[0] : '' %>"
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">ลูกค้า</label>
                        <select name="customer_id" required
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium appearance-none">
                            <option value="">เลือกลูกค้า</option>
                            <% customers.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=item.customer_id===c.id ? 'selected' : '' %>><%= c.name
                                        %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">พนักงานขาย</label>
                        <select name="sale_emp_id"
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium appearance-none">
                            <option value="">เลือกพนักงานขาย</option>
                            <% employees.forEach(e=> { %>
                                <option value="<%= e.id %>" <%=item.sale_emp_id===e.id ? 'selected' : '' %>><%= e.fname
                                        %>
                                        <%= e.lname %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">ประเภทบริการ</label>
                        <select name="service_type_id" required
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium appearance-none">
                            <option value="">เลือกประเภทบริการ</option>
                            <% serviceTypes.forEach(st=> { %>
                                <option value="<%= st.id %>" <%=item.service_type_id===st.id ? 'selected' : '' %>><%=
                                        st.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">ชื่อโครงการ/บริการ</label>
                        <input type="text" name="service_name" value="<%= item.service_name || '' %>"
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                            placeholder="เช่น บริการกำจัดปลวกประจำปี">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">เครดิตเทอม (วัน)</label>
                        <input type="number" name="credit_term" value="<%= item.credit_term || 0 %>"
                            class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                    </div>
                </div>
            </div>

            <!-- Line Items -->
            <div class="lg:col-span-12">
                <div class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 p-8 space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-50 pb-4">
                        <h3 class="text-lg font-bold text-slate-800 flex items-center">
                            <i class="fa-solid fa-list-ul text-emerald-500 mr-2"></i>
                            รายการสินค้า/บริการ
                        </h3>
                        <button type="button" onclick="addRow()"
                            class="bg-emerald-50 text-emerald-600 hover:bg-emerald-100 px-4 py-2 rounded-xl font-bold text-sm transition-all flex items-center space-x-1">
                            <i class="fa-solid fa-plus-circle"></i>
                            <span>เพิ่มรายการ</span>
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full no-border" id="linesTable">
                            <thead>
                                <tr class="text-left text-slate-400 text-xs uppercase tracking-widest">
                                    <th class="pb-4 pl-2">รายการ</th>
                                    <th class="pb-4 px-2 w-24 text-right">จำนวน</th>
                                    <th class="pb-4 px-2 w-32 text-right">ราคา/หน่วย</th>
                                    <th class="pb-4 px-2 w-32 text-right">รวม</th>
                                    <th class="pb-4 w-10"></th>
                                </tr>
                            </thead>
                            <tbody id="linesContainer">
                                <% lines.forEach((line, index)=> { %>
                                    <tr class="group border-b border-slate-50 last:border-0 growable-row">
                                        <td class="py-4 pr-2">
                                            <input type="text" name="lines[<%= index %>][name]" required
                                                value="<%= line.name %>"
                                                class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-xl outline-none transition-all font-medium"
                                                placeholder="ระบุรายการสินค้า/บริการ">
                                            <input type="hidden" name="lines[<%= index %>][item_id]"
                                                value="<%= line.item_id %>" class="item-id-input">
                                            <input type="hidden" name="lines[<%= index %>][unit_id]"
                                                value="<%= line.unit_id %>" class="unit-id-input">
                                        </td>
                                        <td class="py-4 px-2">
                                            <input type="number" name="lines[<%= index %>][qty]" step="1"
                                                value="<%= line.qty %>" onchange="updateLineTotal(this)"
                                                class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-xl outline-none transition-all font-medium text-right qty-input">
                                        </td>
                                        <td class="py-4 px-2">
                                            <input type="number" name="lines[<%= index %>][price_per_unit]" step="0.01"
                                                value="<%= line.price_per_unit %>" onchange="updateLineTotal(this)"
                                                class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-xl outline-none transition-all font-medium text-right price-input">
                                        </td>
                                        <td class="py-4 px-2">
                                            <input type="number" name="lines[<%= index %>][line_total]" step="0.01"
                                                value="<%= line.line_total %>" readonly
                                                class="w-full px-4 py-3 bg-slate-100 border-none rounded-xl font-bold text-right text-slate-700 line-total-input outline-none">
                                        </td>
                                        <td class="py-4 pl-2 text-right">
                                            <button type="button" onclick="removeRow(this)"
                                                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-300 hover:text-rose-500 hover:bg-rose-50 transition-all">
                                                <i class="fa-solid fa-trash-can text-sm"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Totals and Tax -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 border-t border-slate-50">
                        <div class="space-y-4">
                            <label class="block text-sm font-bold text-slate-700 ml-1">หมายเหตุ</label>
                            <textarea name="note" rows="4"
                                class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                                placeholder="รายละเอียดเพิ่มเติมหรือเงื่อนไขพิเศษ..."><%= item.note || '' %></textarea>
                        </div>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center text-slate-600">
                                <span class="font-bold">รวมเป็นเงิน:</span>
                                <input type="number" name="sub_total" id="sub_total" value="<%= item.sub_total || 0 %>"
                                    readonly
                                    class="w-32 bg-transparent border-none text-right font-bold focus:outline-none">
                            </div>
                            <div class="flex justify-between items-center text-slate-600">
                                <span class="font-bold">ภาษีมูลค่าเพิ่ม (7%):</span>
                                <div class="flex items-center space-x-2">
                                    <input type="checkbox" id="tax_enable"
                                        class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
                                        <%=item.sale_tax> 0 ? 'checked' : '' %> onchange="calculateGrandTotal()">
                                    <input type="number" name="sale_tax" id="sale_tax" value="<%= item.sale_tax || 0 %>"
                                        readonly
                                        class="w-32 bg-transparent border-none text-right font-bold focus:outline-none">
                                </div>
                            </div>
                            <div class="flex justify-between items-center pt-4 border-t border-slate-100">
                                <span class="text-xl font-black text-slate-800">ยอดรวมสุทธิ:</span>
                                <input type="number" name="total" id="total" value="<%= item.total || 0 %>" readonly
                                    class="w-40 bg-transparent border-none text-right text-2xl font-black text-emerald-600 focus:outline-none">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <template id="lineRowTemplate">
        <tr class="group border-b border-slate-50 last:border-0 growable-row">
            <td class="py-4 pr-2">
                <input type="text" name="lines[INDEX][name]" required
                    class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-xl outline-none transition-all font-medium"
                    placeholder="ระบุรายการสินค้า/บริการ">
                <input type="hidden" name="lines[INDEX][item_id]" class="item-id-input">
                <input type="hidden" name="lines[INDEX][unit_id]" class="unit-id-input">
            </td>
            <td class="py-4 px-2">
                <input type="number" name="lines[INDEX][qty]" step="1" value="1" onchange="updateLineTotal(this)"
                    class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-xl outline-none transition-all font-medium text-right qty-input">
            </td>
            <td class="py-4 px-2">
                <input type="number" name="lines[INDEX][price_per_unit]" step="0.01" value="0"
                    onchange="updateLineTotal(this)"
                    class="w-full px-4 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-xl outline-none transition-all font-medium text-right price-input">
            </td>
            <td class="py-4 px-2">
                <input type="number" name="lines[INDEX][line_total]" step="0.01" value="0" readonly
                    class="w-full px-4 py-3 bg-slate-100 border-none rounded-xl font-bold text-right text-slate-700 line-total-input outline-none">
            </td>
            <td class="py-4 pl-2 text-right">
                <button type="button" onclick="removeRow(this)"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-300 hover:text-rose-500 hover:bg-rose-50 transition-all">
                    <i class="fa-solid fa-trash-can text-sm"></i>
                </button>
            </td>
        </tr>
    </template>

    <script>
        let rowIndex = <%= (typeof lines !== 'undefined' && lines) ? lines.length : 0 %>;
        const container = document.getElementById('linesContainer');
        const template = document.getElementById('lineRowTemplate').innerHTML;

        function addRow() {
            const html = template.replace(/INDEX/g, rowIndex);
            const tr = document.createElement('tr');
            tr.className = "group border-b border-slate-50 last:border-0";
            tr.innerHTML = html;
            container.appendChild(tr);
            rowIndex++;
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            calculateGrandTotal();
        }

        function updateLineTotal(input) {
            const row = input.closest('tr');
            const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
            const price = parseFloat(row.querySelector('.price-input').value) || 0;

            const total = qty * price;
            row.querySelector('.line-total-input').value = total.toFixed(2);
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            let subTotal = 0;
            document.querySelectorAll('.line-total-input').forEach(input => {
                subTotal += parseFloat(input.value) || 0;
            });

            document.getElementById('sub_total').value = subTotal.toFixed(2);

            let tax = 0;
            if (document.getElementById('tax_enable').checked) {
                tax = subTotal * 0.07;
            }

            document.getElementById('sale_tax').value = tax.toFixed(2);
            document.getElementById('total').value = (subTotal + tax).toFixed(2);
        }
    </script>

    <%- include('../partials/layout_end') %>