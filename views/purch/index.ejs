<%- include('../partials/layout_start') %>

    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">ใบสั่งซื้อ (Purchase Order)</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการรายการสั่งซื้อสินค้าไปยังเวนเดอร์</p>
        </div>
        <a href="/pur-orders/create"
            class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-2xl shadow-lg shadow-indigo-100 transition-all active:scale-95 flex items-center space-x-2">
            <i class="fa-solid fa-plus"></i>
            <span>สร้างใบสั่งซื้อ</span>
        </a>
    </div>

    <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50/50">
                    <tr>
                        <th class="px-8 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">
                            เลขที่ใบสั่งซื้อ</th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">วันที่</th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">เวนเดอร์</th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">สถานะ</th>
                        <th class="px-8 py-5 text-right text-slate-400 font-bold text-xs uppercase tracking-widest">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% items.forEach(item=> { %>
                        <tr class="group hover:bg-indigo-50/20 transition-all">
                            <td class="px-8 py-6 font-bold text-slate-700">
                                <%= item.purch_no %>
                            </td>
                            <td class="px-4 py-6 text-slate-500 text-sm">
                                <%= new Date(item.purch_date).toLocaleDateString('th-TH') %>
                            </td>
                            <td class="px-4 py-6 text-slate-500 text-sm">
                                <%= item.vendor_name || '-' %>
                            </td>
                            <td class="px-4 py-6">
                                <% if (item.status===1) { %>
                                    <span
                                        class="bg-amber-50 text-amber-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-amber-100">รอดำเนินการ</span>
                                    <% } else if (item.status===2) { %>
                                        <span
                                            class="bg-blue-50 text-blue-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-blue-100">สั่งซื้อแล้ว</span>
                                        <% } else if (item.status===5) { %>
                                            <span
                                                class="bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-emerald-100">รับสินค้าครบแล้ว</span>
                                            <% } %>
                            </td>
                            <td class="px-8 py-6 text-right">
                                <div class="flex justify-end space-x-2">
                                    <% if (item.status !==5) { %>
                                        <button onclick="openReceiveModal('<%= item.id %>', '<%= item.purch_no %>')"
                                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 hover:bg-emerald-50 transition-all"
                                            title="รับสินค้า">
                                            <i class="fa-solid fa-truck-ramp-box text-sm"></i>
                                        </button>
                                        <% } %>
                                            <a href="/pur-orders/print/<%= item.id %>" target="_blank"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all"
                                                title="พิมพ์">
                                                <i class="fa-solid fa-print text-sm"></i>
                                            </a>
                                            <a href="/pur-orders/edit/<%= item.id %>"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all"
                                                title="แก้ไข">
                                                <i class="fa-solid fa-pen-to-square text-sm"></i>
                                            </a>
                                            <button
                                                onclick="if(confirm('ยืนยันการลบ?')) window.location.href='/pur-orders/delete/<%= item.id %>'"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all"
                                                title="ลบ">
                                                <i class="fa-solid fa-trash-can text-sm"></i>
                                            </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Receive Modal -->
    <div id="receiveModal"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col">
            <div class="p-8 border-b border-slate-100 flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-black text-slate-800 tracking-tight">รับเข้าสินค้า</h2>
                    <p class="text-slate-500 font-bold text-sm uppercase tracking-widest mt-1" id="modalPoNo">PO: -</p>
                </div>
                <button onclick="closeReceiveModal()"
                    class="w-12 h-12 flex items-center justify-center rounded-2xl bg-slate-50 text-slate-400 hover:text-rose-500 transition-all">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="p-8 overflow-y-auto flex-1 custom-scrollbar">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 font-bold text-xs uppercase tracking-widest border-b border-slate-50">
                            <th class="pb-4">สินค้า</th>
                            <th class="pb-4 w-32 text-center">ต้องรับ</th>
                            <th class="pb-4 w-32 text-center">จำนวนที่รับ</th>
                        </tr>
                    </thead>
                    <tbody id="receiveTableBody" class="divide-y divide-slate-50">
                        <!-- Rows injected by JS -->
                    </tbody>
                </table>
            </div>

            <div class="p-8 bg-slate-50 border-t border-slate-100 flex justify-end space-x-4">
                <button onclick="closeReceiveModal()"
                    class="px-8 py-4 bg-white border border-slate-200 text-slate-500 font-bold rounded-2xl hover:bg-slate-100 transition-all active:scale-95">ยกเลิก</button>
                <button onclick="submitReceive()"
                    class="px-8 py-4 bg-emerald-600 text-white font-bold rounded-2xl shadow-xl shadow-emerald-500/20 hover:bg-emerald-700 transition-all active:scale-95 flex items-center space-x-2">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                    <span>บันทึกการรับเข้า</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentPoId = null;

        async function openReceiveModal(id, poNo) {
            currentPoId = id;
            document.getElementById('modalPoNo').innerText = 'PO: ' + poNo;
            const body = document.getElementById('receiveTableBody');
            body.innerHTML = '<tr><td colspan="3" class="py-10 text-center text-slate-400">กำลังโหลด...</td></tr>';

            document.getElementById('receiveModal').classList.remove('hidden');

            try {
                const res = await fetch('/pur-orders/receive/' + id);
                const items = await res.json();

                if (items.length === 0) {
                    body.innerHTML = '<tr><td colspan="3" class="py-10 text-center text-slate-400">ไม่พบรายการค้างรับ</td></tr>';
                    return;
                }

                body.innerHTML = items.map(item => `
                    <tr class="group hover:bg-emerald-50/20 transition-all" data-line-id="${item.id}" data-product-id="${item.product_id}">
                        <td class="py-5">
                            <p class="font-bold text-slate-700">${item.product_name}</p>
                            <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest">${item.product_code}</p>
                        </td>
                        <td class="py-5 text-center font-bold text-indigo-600">${item.remain_qty}</td>
                        <td class="py-5">
                            <input type="number" class="receive-qty w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl text-center focus:ring-2 focus:ring-emerald-500 outline-none transition-all" 
                                value="${item.remain_qty}" max="${item.remain_qty}" min="0" step="any">
                        </td>
                    </tr>
                `).join('');
            } catch (err) {
                console.error(err);
                body.innerHTML = '<tr><td colspan="3" class="py-10 text-center text-rose-500 font-bold">เกิดข้อผิดพลาดในการโหลดข้อมูล</td></tr>';
            }
        }

        function closeReceiveModal() {
            document.getElementById('receiveModal').classList.add('hidden');
        }

        async function submitReceive() {
            const rows = document.querySelectorAll('#receiveTableBody tr[data-line-id]');
            const receives = [];

            rows.forEach(row => {
                const qty = parseFloat(row.querySelector('.receive-qty').value) || 0;
                if (qty > 0) {
                    receives.push({
                        line_id: row.dataset.lineId,
                        product_id: row.dataset.productId,
                        qty: qty
                    });
                }
            });

            if (receives.length === 0) {
                alert('กรุณาระบุจำนวนสินค้าที่ต้องการรับ');
                return;
            }

            try {
                const res = await fetch('/pur-orders/save-receive', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ po_id: currentPoId, receives })
                });
                const result = await res.json();

                if (result.success) {
                    window.location.reload();
                } else {
                    alert('เกิดข้อผิดพลาด: ' + (result.error || 'ไม่ทราบสาเหตุ'));
                }
            } catch (err) {
                console.error(err);
                alert('เกิดข้อผิดพลาดในการบันทึกข้อมูล');
            }
        }
    </script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #cbd5e1;
        }
    </style>

    <%- include('../partials/layout_end') %>