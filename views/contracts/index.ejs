<%- include('../partials/layout_start') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">สัญญาบริการ</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการสัญญาบริการของลูกค้าในระบบ</p>
        </div>
        <a href="/contracts/create"
            class="flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-2xl shadow-lg shadow-emerald-200 transition-all active:scale-95 font-bold">
            <i class="fa-solid fa-plus text-sm"></i>
            <span>สร้างสัญญาใหม่</span>
        </a>
    </div>

    <div class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-emerald-50/50">
                        <th class="px-6 py-5 text-emerald-800 font-bold text-sm uppercase tracking-wider">เลขที่สัญญา
                        </th>
                        <th class="px-6 py-5 text-emerald-800 font-bold text-sm uppercase tracking-wider">ลูกค้า</th>
                        <th class="px-6 py-5 text-emerald-800 font-bold text-sm uppercase tracking-wider">
                            วันที่เริ่ม-หมดอายุ</th>
                        <th class="px-6 py-5 text-emerald-800 font-bold text-sm uppercase tracking-wider text-center">
                            สถานะ</th>
                        <th class="px-6 py-5 text-emerald-800 font-bold text-sm uppercase tracking-wider text-right">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-emerald-50">
                    <% items.forEach((item)=> { %>
                        <tr class="hover:bg-emerald-50/30 transition-colors group">
                            <td class="px-6 py-5 font-bold text-slate-700">
                                <%= item.contract_no %>
                            </td>
                            <td class="px-6 py-5 text-slate-600">
                                <%= item.customer_name || '-' %>
                            </td>
                            <td class="px-6 py-5 text-slate-600">
                                <%= item.contract_start_date ? new
                                    Date(item.contract_start_date).toLocaleDateString('th-TH') : '-' %> -
                                    <%= item.contract_expire_date ? new
                                        Date(item.contract_expire_date).toLocaleDateString('th-TH') : '-' %>
                            </td>
                            <td class="px-6 py-5 text-center">
                                <% if (item.status===2) { %>
                                    <span
                                        class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-xs font-bold ring-1 ring-emerald-200">
                                        ใช้งานอยู่
                                    </span>
                                    <% } else { %>
                                        <span
                                            class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-xs font-bold ring-1 ring-blue-200">
                                            รอดำเนินการ
                                        </span>
                                        <% } %>
                            </td>
                            <td class="px-6 py-5 text-right">
                                <div
                                    class="flex justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <% if (item.status !==2) { %>
                                        <a href="/contracts/approve/<%= item.id %>"
                                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 hover:bg-emerald-50 transition-all"
                                            title="อนุมัติสัญญา">
                                            <i class="fa-solid fa-check text-sm"></i>
                                        </a>
                                        <% } else { %>
                                            <a href="/contracts/gen-plan/<%= item.id %>"
                                                onclick="return confirm('ยืนยันสร้างแผนบริการ?')"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-amber-600 hover:border-amber-200 hover:bg-amber-50 transition-all"
                                                title="สร้างแผนบริการ">
                                                <i class="fa-solid fa-calendar-days text-sm"></i>
                                            </a>
                                            <% } %>
                                                <a href="/contracts/timeline/<%= item.id %>"
                                                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all"
                                                    title="ดู Timeline">
                                                    <i class="fa-solid fa-diagram-project text-sm"></i>
                                                </a>
                                                <a href="/contracts/print/<%= item.id %>" target="_blank"
                                                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-blue-600 hover:border-blue-200 hover:bg-blue-50 transition-all">
                                                    <i class="fa-solid fa-print text-sm"></i>
                                                </a>
                                                <a href="/contracts/edit/<%= item.id %>"
                                                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 hover:bg-emerald-50 transition-all">
                                                    <i class="fa-solid fa-pen-to-square text-sm"></i>
                                                </a>
                                                <a href="/contracts/delete/<%= item.id %>"
                                                    onclick="return confirm('ยืนยันการลบสัญญา?')"
                                                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                                    <i class="fa-solid fa-trash-can text-sm"></i>
                                                </a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (items.length===0) { %>
                                <tr>
                                    <td colspan="5" class="px-6 py-20 text-center text-slate-400">
                                        <i class="fa-solid fa-file-contract text-5xl mb-4 opacity-20 block"></i>
                                        <span class="font-medium">ไม่พบข้อมูลสัญญาบริการ</span>
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>
        <%- include('../partials/pagination') %>
    </div>

    <%- include('../partials/layout_end') %>