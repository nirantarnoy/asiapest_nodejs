<%- include('../partials/layout_start') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">Timeline สัญญา: <%= contract.contract_no
                    %>
            </h1>
            <p class="text-slate-500 mt-1 font-medium">ติดตามสถานะและความคืบหน้าของกิจกรรมทั้งหมด</p>
        </div>
        <div class="flex space-x-3">
            <a href="/contracts"
                class="flex items-center justify-center space-x-2 bg-white border border-slate-200 text-slate-600 px-6 py-3 rounded-2xl shadow-sm hover:bg-slate-50 transition-all font-bold">
                <i class="fa-solid fa-arrow-left text-sm"></i>
                <span>กลับหน้าหลัก</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-8 max-w-7xl mx-auto pb-20">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <div class="bg-white p-6 rounded-3xl border border-emerald-50 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">ประเมินราคา</p>
                <h4 class="text-lg font-bold text-slate-700">
                    <%= estimate ? estimate.journal_no : 'N/A' %>
                </h4>
                <p class="text-xs text-slate-400 mt-1">
                    <%= estimate ? new Date(estimate.trans_date).toLocaleDateString('th-TH') : '-' %>
                </p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-emerald-50 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">ใบเสนอราคา</p>
                <h4 class="text-lg font-bold text-slate-700">
                    <%= quotation ? quotation.quotation_no : 'N/A' %>
                </h4>
                <p class="text-xs text-slate-400 mt-1">
                    <%= quotation ? new Date(quotation.quotation_date).toLocaleDateString('th-TH') : '-' %>
                </p>
            </div>
            <div class="bg-emerald-600 p-6 rounded-3xl border border-emerald-50 shadow-lg shadow-emerald-100">
                <p class="text-xs font-bold text-white/70 uppercase tracking-wider mb-2">สัญญา</p>
                <h4 class="text-lg font-bold text-white">
                    <%= contract.contract_no %>
                </h4>
                <p class="text-xs text-white/70 mt-1">
                    <%= contract.contract_date ? new Date(contract.contract_date).toLocaleDateString('th-TH') : '-' %>
                </p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-emerald-50 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">แผนงาน (Plans)</p>
                <h4 class="text-lg font-bold text-slate-700">
                    <%= plans.length %> รายการ
                </h4>
                <p class="text-xs text-slate-400 mt-1">กำหนดการทั้งหมด</p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-emerald-50 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Job Card</p>
                <h4 class="text-lg font-bold text-slate-700">
                    <%= jobCards.length %> รายการ
                </h4>
                <p class="text-xs text-slate-400 mt-1">บันทึกหน้างาน</p>
            </div>
        </div>

        <!-- Timeline UI -->
        <div class="bg-white rounded-[2.5rem] shadow-sm border border-emerald-50 p-8 overflow-hidden">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-xl font-bold text-slate-800">ลำดับกิจกรรม (Activity Sequence)</h3>
                <div class="flex space-x-4">
                    <div class="flex items-center text-xs font-medium text-slate-500">
                        <span class="w-3 h-3 rounded-full bg-emerald-500 mr-2"></span> เสร็จสิ้น
                    </div>
                    <div class="flex items-center text-xs font-medium text-slate-500">
                        <span class="w-3 h-3 rounded-full bg-blue-500 mr-2"></span> ดำเนินการ
                    </div>
                    <div class="flex items-center text-xs font-medium text-slate-500">
                        <span class="w-3 h-3 rounded-full bg-slate-200 mr-2"></span> รอดำเนินการ
                    </div>
                </div>
            </div>

            <div class="relative">
                <!-- Central Line -->
                <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-slate-100"></div>

                <div class="space-y-12">
                    <!-- 1. Estimate -->
                    <% if(estimate) { %>
                        <div class="relative pl-20 group">
                            <div
                                class="absolute left-6 top-0 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm ring-2 ring-emerald-50 group-hover:scale-125 transition-transform">
                            </div>
                            <div>
                                <div class="flex items-center mb-1">
                                    <span
                                        class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded-full uppercase mr-3">Completed</span>
                                    <h5 class="text-lg font-bold text-slate-800">ประเมินราคา (Estimate)</h5>
                                </div>
                                <div class="flex flex-col md:flex-row md:items-center gap-4 text-sm text-slate-500">
                                    <span><i class="fa-solid fa-file-invoice mr-2"></i>
                                        <%= estimate.journal_no %>
                                    </span>
                                    <span><i class="fa-solid fa-calendar mr-2"></i>
                                        <%= new Date(estimate.trans_date).toLocaleDateString('th-TH') %>
                                    </span>
                                    <div
                                        class="flex-1 h-2 bg-emerald-100 rounded-full overflow-hidden max-w-md mt-2 md:mt-0">
                                        <div class="h-full bg-emerald-500 rounded-full" style="width: 100%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>

                            <!-- 2. Quotation -->
                            <% if(quotation) { %>
                                <div class="relative pl-20 group">
                                    <div
                                        class="absolute left-6 top-0 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm ring-2 ring-emerald-50 group-hover:scale-125 transition-transform">
                                    </div>
                                    <div>
                                        <div class="flex items-center mb-1">
                                            <span
                                                class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded-full uppercase mr-3">Completed</span>
                                            <h5 class="text-lg font-bold text-slate-800">ใบเสนอราคา (Quotation)</h5>
                                        </div>
                                        <div
                                            class="flex flex-col md:flex-row md:items-center gap-4 text-sm text-slate-500">
                                            <span><i class="fa-solid fa-file-contract mr-2"></i>
                                                <%= quotation.quotation_no %>
                                            </span>
                                            <span><i class="fa-solid fa-calendar mr-2"></i>
                                                <%= new Date(quotation.quotation_date).toLocaleDateString('th-TH') %>
                                            </span>
                                            <div
                                                class="flex-1 h-2 bg-emerald-100 rounded-full overflow-hidden max-w-md mt-2 md:mt-0">
                                                <div class="h-full bg-emerald-500 rounded-full" style="width: 100%">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- 3. Contract -->
                                    <div class="relative pl-20 group">
                                        <div
                                            class="absolute left-6 top-0 w-4 h-4 rounded-full bg-blue-500 border-4 border-white shadow-sm ring-2 ring-blue-50 group-hover:scale-125 transition-transform">
                                        </div>
                                        <div>
                                            <div class="flex items-center mb-1">
                                                <span
                                                    class="px-2 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-bold rounded-full uppercase mr-3">Active</span>
                                                <h5 class="text-lg font-bold text-slate-800">สัญญาบริการ (Contract)</h5>
                                            </div>
                                            <div
                                                class="flex flex-col md:flex-row md:items-center gap-4 text-sm text-slate-500">
                                                <span><i class="fa-solid fa-signature mr-2"></i>
                                                    <%= contract.contract_no %>
                                                </span>
                                                <span><i class="fa-solid fa-calendar mr-2"></i>
                                                    <%= contract.contract_date ? new
                                                        Date(contract.contract_date).toLocaleDateString('th-TH') : '-'
                                                        %>
                                                </span>
                                                <div
                                                    class="flex-1 h-2 bg-blue-100 rounded-full overflow-hidden max-w-md mt-2 md:mt-0">
                                                    <div class="h-full bg-blue-500 rounded-full" style="width: 75%">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 4. Service Order (If exists) -->
                                    <% services.forEach(s=> { %>
                                        <div class="relative pl-20 group">
                                            <div
                                                class="absolute left-6 top-0 w-4 h-4 rounded-full bg-blue-500 border-4 border-white shadow-sm ring-2 ring-blue-50 group-hover:scale-125 transition-transform">
                                            </div>
                                            <div>
                                                <div class="flex items-center mb-1">
                                                    <span
                                                        class="px-2 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-bold rounded-full uppercase mr-3">Processing</span>
                                                    <h5 class="text-lg font-bold text-slate-800">ใบบริการ (Service
                                                        Order)</h5>
                                                </div>
                                                <div
                                                    class="flex flex-col md:flex-row md:items-center gap-4 text-sm text-slate-500">
                                                    <span><i class="fa-solid fa-hand-holding-hand mr-2"></i>
                                                        <%= s.service_no %>
                                                    </span>
                                                    <span class="px-3 py-1 bg-slate-50 rounded-lg">Status Code: <%=
                                                            s.status %></span>
                                                    <div
                                                        class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden max-w-md mt-2 md:mt-0">
                                                        <div class="h-full bg-blue-500 rounded-full"
                                                            style="width: <%= s.status > 0 ? '100%' : '50%' %>"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>

                                            <!-- 5. Plans (Grouped) -->
                                            <% if(plans.length> 0) { %>
                                                <div class="relative pl-20 group">
                                                    <div
                                                        class="absolute left-6 top-0 w-4 h-4 rounded-full bg-indigo-500 border-4 border-white shadow-sm ring-2 ring-indigo-50 group-hover:scale-125 transition-transform">
                                                    </div>
                                                    <div>
                                                        <div class="flex items-center mb-3">
                                                            <span
                                                                class="px-2 py-0.5 bg-indigo-100 text-indigo-700 text-[10px] font-bold rounded-full uppercase mr-3">Scheduled</span>
                                                            <h5 class="text-lg font-bold text-slate-800">แผนงานนัดหมาย
                                                                (Service Plans)</h5>
                                                        </div>

                                                        <div class="overflow-x-auto">
                                                            <div class="flex space-x-2 min-w-max pb-4">
                                                                <% plans.forEach((p, idx)=> { %>
                                                                    <div
                                                                        class="w-48 bg-slate-50 p-4 rounded-2xl border border-slate-100">
                                                                        <p
                                                                            class="text-[10px] font-bold text-indigo-500 uppercase mb-1">
                                                                            Round <%= p.interval_no %>
                                                                        </p>
                                                                        <p
                                                                            class="text-xs font-bold text-slate-700 mb-2 truncate">
                                                                            <%= p.plan_no %>
                                                                        </p>
                                                                        <p class="text-[10px] text-slate-400">
                                                                            <%= new
                                                                                Date(p.target_date).toLocaleDateString('th-TH')
                                                                                %>
                                                                        </p>
                                                                        <div
                                                                            class="w-full h-1 bg-slate-200 mt-3 rounded-full">
                                                                            <div class="h-full bg-indigo-500 rounded-full"
                                                                                style="width: <%= p.status > 1 ? '100%' : '30%' %>">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <% }) %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <!-- 6. Job Cards -->
                                                    <% if(jobCards.length> 0) { %>
                                                        <div class="relative pl-20 group">
                                                            <div
                                                                class="absolute left-6 top-0 w-4 h-4 rounded-full bg-amber-500 border-4 border-white shadow-sm ring-2 ring-amber-50 group-hover:scale-125 transition-transform">
                                                            </div>
                                                            <div>
                                                                <div class="flex items-center mb-3">
                                                                    <span
                                                                        class="px-2 py-0.5 bg-amber-100 text-amber-700 text-[10px] font-bold rounded-full uppercase mr-3">Recording</span>
                                                                    <h5 class="text-lg font-bold text-slate-800">Job
                                                                        Cards</h5>
                                                                </div>

                                                                <div
                                                                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                                                    <% jobCards.forEach(jc=> { %>
                                                                        <div
                                                                            class="flex items-center p-4 bg-amber-50/50 rounded-2xl border border-amber-100">
                                                                            <i
                                                                                class="fa-solid fa-clipboard-check text-amber-500 text-xl mr-4"></i>
                                                                            <div>
                                                                                <p
                                                                                    class="text-sm font-bold text-slate-700">
                                                                                    <%= jc.job_card_no %>
                                                                                </p>
                                                                                <p class="text-[10px] text-slate-500">
                                                                                    Created: <%= new Date(jc.created_at
                                                                                        *
                                                                                        1000).toLocaleDateString('th-TH')
                                                                                        %>
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                        <% }) %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% } %>

                                                            <div class="relative pl-20 group">
                                                                <div
                                                                    class="absolute left-6 top-0 w-4 h-4 rounded-full bg-slate-200 border-4 border-white">
                                                                </div>
                                                                <div>
                                                                    <h5 class="text-lg font-bold text-slate-300 italic">
                                                                        ... กิจกรรมในอนาคต ...</h5>
                                                                </div>
                                                            </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Microsoft Project-like Gantt/Progress bar enhancements */
        .progress-bar-container {
            height: 24px;
            background: #f1f5f9;
            border-radius: 6px;
            overflow: hidden;
            position: relative;
        }

        .progress-bar-fill {
            height: 100%;
            background: #10b981;
            transition: width 0.5s ease-out;
        }
    </style>

    <%- include('../partials/layout_end') %>