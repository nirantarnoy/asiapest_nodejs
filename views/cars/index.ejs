<%- include('../partials/layout_start') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">รถ</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการข้อมูลรถในระบบ</p>
        </div>
        <button onclick="openAddModal()"
            class="flex items-center justify-center space-x-2 bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-3 rounded-2xl shadow-lg shadow-cyan-200 transition-all active:scale-95 font-bold">
            <i class="fa-solid fa-plus text-sm"></i>
            <span>เพิ่มรถ</span>
        </button>
    </div>

    <div class="bg-white rounded-[2rem] shadow-sm border border-cyan-50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-cyan-50/50">
                        <th class="px-6 py-5 text-cyan-800 font-bold text-sm uppercase tracking-wider">รหัส</th>
                        <th class="px-6 py-5 text-cyan-800 font-bold text-sm uppercase tracking-wider">ชื่อรถ
                        </th>
                        <th class="px-6 py-5 text-cyan-800 font-bold text-sm uppercase tracking-wider">ประเภทรถ
                        </th>
                        <th class="px-6 py-5 text-cyan-800 font-bold text-sm uppercase tracking-wider">ทะเบียน
                        </th>
                        <th class="px-6 py-5 text-cyan-800 font-bold text-sm uppercase tracking-wider">รายละเอียด
                        </th>
                        <th class="px-6 py-5 text-cyan-800 font-bold text-sm uppercase tracking-wider text-right">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-cyan-50">
                    <% cars.forEach(car=> { %>
                        <tr class="hover:bg-cyan-50/30 transition-colors group">
                            <td class="px-6 py-5">
                                <span
                                    class="bg-cyan-100 text-cyan-700 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-cyan-200">
                                    <%= car.code %>
                                </span>
                            </td>
                            <td class="px-6 py-5 font-bold text-slate-700">
                                <%= car.name %>
                            </td>
                            <td class="px-6 py-5 text-slate-600">
                                <%= car.type_name || '-' %>
                            </td>
                            <td class="px-6 py-5 text-slate-600">
                                <% if (car.plate_number) { %>
                                    <span
                                        class="bg-amber-100 text-amber-800 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-amber-200">
                                        <%= car.plate_number %>
                                    </span>
                                    <% } else { %>
                                        <span class="text-slate-400">-</span>
                                        <% } %>
                            </td>
                            <td class="px-6 py-5 text-slate-500 text-sm">
                                <%= car.description || '-' %>
                            </td>
                            <td class="px-6 py-5 text-right">
                                <div
                                    class="flex justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button onclick='openEditModal(<%- JSON.stringify(car) %>)'
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-cyan-600 hover:border-cyan-200 hover:bg-cyan-50 transition-all">
                                        <i class="fa-solid fa-pen-to-square text-sm"></i>
                                    </button>
                                    <a href="/cars/delete/<%= car.id %>" onclick="return confirm('ยืนยันการลบข้อมูล?')"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (cars.length===0) { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-20 text-center text-slate-400">
                                        <i class="fa-solid fa-folder-open text-5xl mb-4 opacity-20 block"></i>
                                        <span class="font-medium">ไม่พบข้อมูลรถ</span>
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <%- include('../partials/pagination') %>
    </div>

    <!-- Add/Edit Modal -->
    <div id="modal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
        <div
            class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-8 border-b border-slate-50 flex justify-between items-center">
                <h3 id="modalTitle" class="text-2xl font-black text-slate-800">เพิ่มรถ</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <form id="modalForm" method="POST" action="/cars/add" class="p-8 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">รหัสรถ</label>
                        <input type="text" name="code" id="carCode" required
                            class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-cyan-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                            placeholder="เช่น CAR-001">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">ประเภทรถ</label>
                        <select name="car_type_id" id="carType"
                            class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-cyan-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                            <option value="">-- เลือกประเภทรถ --</option>
                            <% types.forEach(type=> { %>
                                <option value="<%= type.id %>">
                                    <%= type.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">ชื่อรถ</label>
                        <input type="text" name="name" id="carName" required
                            class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-cyan-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                            placeholder="ชื่อรถ">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 ml-1">ทะเบียนรถ</label>
                        <input type="text" name="plate_number" id="carPlate"
                            class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-cyan-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                            placeholder="เช่น กก-1234">
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 ml-1">รายละเอียด</label>
                    <textarea name="description" id="carDescription" rows="3"
                        class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-cyan-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                        placeholder="รายละเอียดเพิ่มเติม"></textarea>
                </div>

                <div class="flex space-x-4 pt-4">
                    <button type="button" onclick="closeModal()"
                        class="flex-1 px-8 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold transition-colors">ยกเลิก</button>
                    <button type="submit"
                        class="flex-1 px-8 py-4 bg-cyan-600 hover:bg-cyan-700 text-white rounded-2xl font-bold shadow-lg shadow-cyan-100 transition-all active:scale-95">บันทึกข้อมูล</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('modal');
        const modalTitle = document.getElementById('modalTitle');
        const modalForm = document.getElementById('modalForm');

        function openAddModal() {
            modalTitle.innerText = 'เพิ่มรถ';
            modalForm.action = '/cars/add';
            document.getElementById('carCode').value = '';
            document.getElementById('carName').value = '';
            document.getElementById('carType').value = '';
            document.getElementById('carPlate').value = '';
            document.getElementById('carDescription').value = '';
            modal.classList.remove('hidden');
        }

        function openEditModal(car) {
            modalTitle.innerText = 'แก้ไขข้อมูลรถ';
            modalForm.action = `/cars/edit/${car.id}`;
            document.getElementById('carCode').value = car.code;
            document.getElementById('carName').value = car.name;
            document.getElementById('carType').value = car.car_type_id || '';
            document.getElementById('carPlate').value = car.plate_number || '';
            document.getElementById('carDescription').value = car.description || '';
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
        }
    </script>

    <%- include('../partials/layout_end') %>