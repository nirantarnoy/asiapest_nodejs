<%- include('../partials/layout_start') %>

    <div class="max-w-5xl mx-auto pb-20">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <a href="/service"
                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 hover:bg-emerald-50 transition-all">
                        <i class="fa-solid fa-arrow-left text-sm"></i>
                    </a>
                    <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">Service Order Details</h1>
                </div>
                <p class="text-slate-500 font-medium ml-[52px]">รายละเอียดใบสั่งบริการ</p>
            </div>
            <div class="flex gap-2">
                <a href="/service/print/<%= item.id %>" target="_blank"
                    class="px-5 py-3 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition-all shadow-sm hover:shadow-md flex items-center gap-2">
                    <i class="fa-solid fa-print"></i>
                    <span>พิมพ์</span>
                </a>
                <a href="/service/edit/<%= item.id %>"
                    class="px-5 py-3 bg-emerald-600 text-white rounded-xl font-bold hover:bg-emerald-700 transition-all shadow-sm hover:shadow-md flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>แก้ไข</span>
                </a>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 overflow-hidden">
            <!-- Document Info Header -->
            <div class="bg-gradient-to-r from-emerald-50 to-teal-50 px-8 py-6 border-b border-emerald-100">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <p class="text-xs text-emerald-600 font-bold uppercase tracking-wider mb-1">Service No.</p>
                        <p class="text-2xl font-bold text-slate-800">
                            <%= item.service_no %>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-emerald-600 font-bold uppercase tracking-wider mb-1">Estimate Ref.</p>
                        <p class="text-lg font-bold text-slate-700">
                            <%= item.journal_no || '-' %>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-emerald-600 font-bold uppercase tracking-wider mb-1">สถานะ</p>
                        <% if (item.status===1) { %>
                            <span
                                class="inline-block bg-emerald-100 text-emerald-700 px-4 py-1.5 rounded-full text-sm font-bold ring-1 ring-emerald-200">
                                <i class="fa-solid fa-circle-check mr-1"></i>Completed
                            </span>
                            <% } else { %>
                                <span
                                    class="inline-block bg-slate-100 text-slate-700 px-4 py-1.5 rounded-full text-sm font-bold ring-1 ring-slate-200">
                                    <i class="fa-solid fa-clock mr-1"></i>Pending
                                </span>
                                <% } %>
                    </div>
                </div>
            </div>

            <!-- Customer Information -->
            <div class="px-8 py-6 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-user-tie text-emerald-600"></i>
                    ข้อมูลลูกค้า
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">ชื่อลูกค้า</p>
                        <p class="text-base font-bold text-slate-800">
                            <%= item.customer_name || '-' %>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">ที่อยู่</p>
                        <p class="text-base text-slate-700">
                            <%= item.customer_address || '-' %>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">เบอร์โทร</p>
                        <p class="text-base text-slate-700">
                            <%= item.customer_phone || '-' %>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">อีเมล</p>
                        <p class="text-base text-slate-700">
                            <%= item.customer_email || '-' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Service Details -->
            <div class="px-8 py-6 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-clipboard-list text-emerald-600"></i>
                    รายละเอียดบริการ
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">วันที่สร้าง</p>
                        <p class="text-base text-slate-700">
                            <%= item.created_at ? new Date(item.created_at * 1000).toLocaleDateString('th-TH', {
                                day: 'numeric' , month: 'long' , year: 'numeric' }) : '-' %>
                        </p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">ผู้สร้าง</p>
                        <p class="text-base text-slate-700">
                            <%= item.creator_name || '-' %>
                        </p>
                    </div>
                    <div class="md:col-span-2">
                        <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">หมายเหตุ</p>
                        <p class="text-base text-slate-700">
                            <%= item.description || '-' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <% if (lines && lines.length> 0) { %>
                <div class="px-8 py-6">
                    <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-boxes-stacked text-emerald-600"></i>
                        รายการสินค้า/บริการ
                    </h3>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-emerald-50/50 border-b-2 border-emerald-100">
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                        ลำดับ
                                    </th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                        รหัสสินค้า
                                    </th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                        รายการ
                                    </th>
                                    <th
                                        class="px-4 py-3 text-right text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                        จำนวน
                                    </th>
                                    <th
                                        class="px-4 py-3 text-right text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                        ราคา/หน่วย
                                    </th>
                                    <th
                                        class="px-4 py-3 text-right text-xs font-bold text-emerald-800 uppercase tracking-wider">
                                        รวม
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% lines.forEach((line, index)=> { %>
                                    <tr class="hover:bg-emerald-50/30 transition-colors">
                                        <td class="px-4 py-3 text-slate-700">
                                            <%= index + 1 %>
                                        </td>
                                        <td class="px-4 py-3 text-slate-700 font-mono">
                                            <%= line.product_code || '-' %>
                                        </td>
                                        <td class="px-4 py-3 text-slate-800 font-semibold">
                                            <%= line.product_name || line.name || '-' %>
                                        </td>
                                        <td class="px-4 py-3 text-right text-slate-700">
                                            <%= (line.qty || 0).toLocaleString() %>
                                        </td>
                                        <td class="px-4 py-3 text-right text-slate-700">
                                            <%= (line.price || 0).toLocaleString(undefined, { minimumFractionDigits: 2
                                                }) %>
                                        </td>
                                        <td class="px-4 py-3 text-right text-slate-800 font-bold">
                                            <%= ((line.qty || 0) * (line.price || 0)).toLocaleString(undefined, {
                                                minimumFractionDigits: 2 }) %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } %>

                    <!-- Action Buttons -->
                    <div class="px-8 py-6 bg-slate-50 border-t border-slate-100">
                        <div class="flex flex-wrap gap-3 justify-end">
                            <a href="/service/create-issue/<%= item.id %>"
                                onclick="return confirm('ยืนยันสร้างใบเบิกสินค้า?')"
                                class="px-5 py-3 bg-amber-600 text-white rounded-xl font-bold hover:bg-amber-700 transition-all shadow-sm hover:shadow-md flex items-center gap-2">
                                <i class="fa-solid fa-box-open"></i>
                                <span>สร้างใบเบิกสินค้า</span>
                            </a>
                            <a href="/service/delete/<%= item.id %>"
                                onclick="return confirm('ยืนยันการลบ Service Order นี้?')"
                                class="px-5 py-3 bg-rose-600 text-white rounded-xl font-bold hover:bg-rose-700 transition-all shadow-sm hover:shadow-md flex items-center gap-2">
                                <i class="fa-solid fa-trash-can"></i>
                                <span>ลบ</span>
                            </a>
                        </div>
                    </div>
        </div>
    </div>

    <%- include('../partials/layout_end') %>