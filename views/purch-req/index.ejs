<%- include('../partials/layout_start') %>

    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">ใบขอซื้อ (Purchase Requisition)</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการรายการขอซื้อสินค้าและพัสดุ</p>
        </div>
        <a href="/pur-req/create"
            class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-6 rounded-2xl shadow-lg shadow-emerald-100 transition-all active:scale-95 flex items-center space-x-2">
            <i class="fa-solid fa-plus"></i>
            <span>สร้างใบขอซื้อ</span>
        </a>
    </div>

    <!-- Search Bar -->
    <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 mb-6">
        <form method="GET" action="/pur-req" class="flex flex-col md:flex-row gap-4">
            <div class="flex-1">
                <input type="text" name="search" value="<%= search || '' %>"
                    placeholder="ค้นหาเลขที่ใบขอซื้อ, หมายเหตุ, ผู้สร้าง..."
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all">
            </div>
            <button type="submit"
                class="px-6 py-3 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-2">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>ค้นหา</span>
            </button>
            <% if (search) { %>
                <a href="/pur-req"
                    class="px-6 py-3 bg-slate-100 text-slate-700 rounded-xl font-bold hover:bg-slate-200 transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-xmark"></i>
                    <span>ล้าง</span>
                </a>
                <% } %>
        </form>
    </div>

    <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50/50">
                    <tr>
                        <th class="px-8 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">เลขที่ใบขอซื้อ
                        </th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">วันที่</th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">ผู้สร้าง</th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">สถานะ</th>
                        <th class="px-8 py-5 text-right text-slate-400 font-bold text-xs uppercase tracking-widest">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% items.forEach(item=> { %>
                        <tr class="group hover:bg-emerald-50/20 transition-all">
                            <td class="px-8 py-6 font-bold text-slate-700">
                                <%= item.purch_req_no %>
                            </td>
                            <td class="px-4 py-6 text-slate-500 text-sm">
                                <%= new Date(item.purch_req_date).toLocaleDateString('th-TH') %>
                            </td>
                            <td class="px-4 py-6 text-slate-500 text-sm">
                                <%= item.creator_name %>
                            </td>
                            <td class="px-4 py-6">
                                <% if (item.status===1) { %>
                                    <span
                                        class="bg-amber-50 text-amber-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-amber-100">รอดำเนินการ</span>
                                    <% } else if (item.status===4) { %>
                                        <span
                                            class="bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-emerald-100">อนุมัติแล้ว</span>
                                        <% } else if (item.status===5) { %>
                                            <span
                                                class="bg-blue-50 text-blue-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-blue-100">โอนย้ายไป
                                                PO</span>
                                            <% } %>
                            </td>
                            <td class="px-8 py-6 text-right">
                                <div class="flex justify-end space-x-2">
                                    <% if (item.status===1) { %>
                                        <a href="/pur-req/approve/<%= item.id %>"
                                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 hover:bg-emerald-50 transition-all"
                                            title="อนุมัติ">
                                            <i class="fa-solid fa-check text-sm"></i>
                                        </a>
                                        <% } %>
                                            <a href="/pur-req/print/<%= item.id %>" target="_blank"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all"
                                                title="พิมพ์">
                                                <i class="fa-solid fa-print text-sm"></i>
                                            </a>
                                            <a href="/pur-req/edit/<%= item.id %>"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all">
                                                <i class="fa-solid fa-pen-to-square text-sm"></i>
                                            </a>
                                            <button
                                                onclick="if(confirm('ยืนยันการลบ?')) window.location.href='/pur-req/delete/<%= item.id %>'"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                                <i class="fa-solid fa-trash-can text-sm"></i>
                                            </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('../partials/layout_end') %>