<%- include('../partials/layout_start') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">เบิกสินค้า (Journal Issue)</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการรายการเบิกสินค้าและวัสดุอุปกรณ์</p>
        </div>
        <a href="/journal-issue/create"
            class="bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-2xl shadow-lg shadow-amber-100 transition-all active:scale-95 flex items-center space-x-2">
            <i class="fa-solid fa-plus"></i>
            <span>บันทึกการเบิกสินค้า</span>
        </a>
    </div>

    <!-- Search Bar -->
    <div class="bg-white rounded-[2rem] shadow-sm border border-amber-50 p-6 mb-6">
        <form method="GET" action="/journal-issue" class="flex flex-col md:flex-row gap-4">
            <div class="flex-1">
                <input type="text" name="search" value="<%= search || '' %>"
                    placeholder="ค้นหา เลขที่ใบเบิก, ผู้เบิก, เหตุผล..."
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-all">
            </div>
            <button type="submit"
                class="px-6 py-3 bg-amber-600 text-white rounded-xl font-bold hover:bg-amber-700 transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-2">
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>ค้นหา</span>
            </button>
            <% if (search) { %>
                <a href="/journal-issue"
                    class="px-6 py-3 bg-slate-100 text-slate-700 rounded-xl font-bold hover:bg-slate-200 transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-xmark"></i>
                    <span>ล้าง</span>
                </a>
                <% } %>
        </form>
    </div>

    <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-slate-50/50">
                    <tr>
                        <th class="px-8 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">เลขที่ใบเบิก
                        </th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">วันที่</th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">ผู้เบิก (User)
                        </th>
                        <th class="px-4 py-5 text-slate-400 font-bold text-xs uppercase tracking-widest">สถานะ</th>
                        <th class="px-8 py-5 text-right text-slate-400 font-bold text-xs uppercase tracking-widest">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    <% if (items.length===0) { %>
                        <tr>
                            <td colspan="5" class="px-8 py-20 text-center text-slate-400 font-medium">
                                ไม่พบรายการเบิกสินค้า</td>
                        </tr>
                        <% } %>
                            <% items.forEach(item=> { %>
                                <tr class="group hover:bg-amber-50/20 transition-all">
                                    <td class="px-8 py-6 font-bold text-slate-700">
                                        <%= item.journal_issue_no %>
                                    </td>
                                    <td class="px-4 py-6 text-slate-500 text-sm">
                                        <%= item.trans_date ? new Date(item.trans_date).toLocaleDateString('th-TH')
                                            : '-' %>
                                    </td>
                                    <td class="px-4 py-6 text-slate-500 text-sm">
                                        <%= item.created_by_name || '-' %>
                                    </td>
                                    <td class="px-4 py-6">
                                        <span
                                            class="bg-emerald-50 text-emerald-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ring-1 ring-emerald-100">บันทึกสำเร็จ</span>
                                    </td>
                                    <td class="px-8 py-6 text-right">
                                        <div class="flex justify-end space-x-2">
                                            <a href="/journal-issue/print/<%= item.id %>" target="_blank"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all"
                                                title="พิมพ์">
                                                <i class="fa-solid fa-print text-sm"></i>
                                            </a>
                                            <button
                                                onclick="if(confirm('ยืนยันการยกเลิกและลบรายการ? การสต๊อกสินค้าจะถูกคืนกลับ')) window.location.href='/journal-issue/delete/<%= item.id %>'"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                                <i class="fa-solid fa-trash-can text-sm"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                </tbody>
            </table>
        </div>
        <%- include('../partials/pagination') %>
    </div>

    <%- include('../partials/layout_end') %>