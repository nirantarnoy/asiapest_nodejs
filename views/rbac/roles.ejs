<%- include('../partials/layout_start') %>

    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">จัดการสิทธิ์ (RBAC)</h1>
        <p class="text-slate-500 mt-1 font-medium">กำหนดสิทธิ์การเข้าใช้งานเมนูต่างๆ สำหรับแต่ละกลุ่ม</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% roles.forEach(role=> { %>
            <div
                class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group">
                <div class="flex justify-between items-start mb-6">
                    <div
                        class="w-14 h-14 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                        <i class="fa-solid fa-user-shield text-2xl"></i>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Role</span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">
                    <%= role.name %>
                </h3>
                <p class="text-slate-500 text-sm mb-8 line-clamp-2">
                    <%= role.description || 'ไม่มีคำอธิบาย' %>
                </p>

                <a href="/rbac/permissions/<%= encodeURIComponent(role.name) %>"
                    class="block w-full text-center py-4 bg-slate-50 hover:bg-indigo-600 hover:text-white text-indigo-600 font-bold rounded-2xl transition-all active:scale-95">
                    จัดการสิทธิ์เข้าถึง
                </a>
            </div>
            <% }) %>
    </div>

    <%- include('../partials/layout_end') %>