<%- include('../partials/layout_start') %>

    <form action="/complain/add" method="POST" class="max-w-7xl mx-auto pb-20">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">สร้างข้อร้องเรียนใหม่</h1>
                <p class="text-slate-500 mt-1 font-medium">บันทึกรายละเอียดข้อร้องเรียนจากลูกค้า</p>
            </div>
            <div class="flex space-x-3">
                <a href="/complain"
                    class="flex items-center justify-center space-x-2 bg-white border border-slate-200 text-slate-600 px-6 py-3 rounded-2xl shadow-sm hover:bg-slate-50 transition-all font-bold">
                    <span>ยกเลิก</span>
                </a>
                <button type="submit"
                    class="flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-2xl shadow-lg shadow-emerald-200 transition-all active:scale-95 font-bold">
                    <i class="fa-solid fa-save text-sm"></i>
                    <span>บันทึกข้อมูล</span>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Main Details -->
            <div class="lg:col-span-12">
                <div class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 p-8 space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700 ml-1">เลขที่</label>
                            <input type="text" readonly placeholder="รันอัตโนมัติ"
                                class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent rounded-2xl outline-none font-medium text-slate-400">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700 ml-1">วันที่ร้องเรียน</label>
                            <input type="date" name="complain_date" required
                                value="<%= new Date().toISOString().split('T')[0] %>"
                                class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700 ml-1">ลูกค้า</label>
                            <select name="customer_id" required
                                class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium appearance-none">
                                <option value="">เลือกลูกค้า</option>
                                <% customers.forEach(c=> { %>
                                    <option value="<%= c.id %>">
                                        <%= c.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="space-y-2">
                            <label
                                class="block text-sm font-bold text-slate-700 ml-1">หัวข้อ/รายละเอียดเบื้องต้น</label>
                            <input type="text" name="description"
                                class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="block text-sm font-bold text-slate-700 ml-1">ปัญหาที่พบ (Problem)</label>
                                <textarea name="problem" rows="3"
                                    class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"></textarea>
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-bold text-slate-700 ml-1">สาเหตุ (Cause)</label>
                                <textarea name="problem_cause" rows="3"
                                    class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"></textarea>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700 ml-1">การดำเนินการ (Action)</label>
                            <textarea name="taken_action" rows="3"
                                class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"></textarea>
                        </div>
                        <div class="w-48 space-y-2">
                            <label class="block text-sm font-bold text-slate-700 ml-1">สถานะ</label>
                            <select name="status"
                                class="w-full px-5 py-3 bg-slate-50 border-2 border-transparent focus:border-emerald-500 focus:bg-white rounded-2xl outline-none transition-all font-medium appearance-none">
                                <option value="1">Open</option>
                                <option value="2">Close</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Sections -->
            <div class="lg:col-span-12 grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Issue Products -->
                <div class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 p-8 space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-50 pb-4">
                        <h3 class="text-lg font-bold text-slate-800 flex items-center">
                            <i class="fa-solid fa-flask text-emerald-500 mr-2"></i>
                            เบิกอุปกรณ์/เคมี
                        </h3>
                        <button type="button" onclick="addProductRow()"
                            class="text-emerald-600 hover:text-emerald-700 font-bold text-sm">
                            <i class="fa-solid fa-plus-circle"></i> เพิ่มรายการ
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left" id="productTable">
                            <thead>
                                <tr class="text-slate-400 text-xs uppercase tracking-wider">
                                    <th class="pb-4">สินค้า</th>
                                    <th class="pb-4 w-24">จำนวน</th>
                                    <th class="pb-4 w-10"></th>
                                </tr>
                            </thead>
                            <tbody id="productContainer">
                                <!-- Rows will be added here -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tracking History -->
                <div class="bg-white rounded-[2rem] shadow-sm border border-emerald-50 p-8 space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-50 pb-4">
                        <h3 class="text-lg font-bold text-slate-800 flex items-center">
                            <i class="fa-solid fa-clock-rotate-left text-emerald-500 mr-2"></i>
                            การติดตามงาน
                        </h3>
                        <button type="button" onclick="addTrackRow()"
                            class="text-emerald-600 hover:text-emerald-700 font-bold text-sm">
                            <i class="fa-solid fa-plus-circle"></i> เพิ่มบันทึก
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left" id="trackTable">
                            <thead>
                                <tr class="text-slate-400 text-xs uppercase tracking-wider">
                                    <th class="pb-4 w-40">วันที่</th>
                                    <th class="pb-4">บันทึก</th>
                                    <th class="pb-4 w-10"></th>
                                </tr>
                            </thead>
                            <tbody id="trackContainer">
                                <!-- Rows will be added here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <template id="productRowTemplate">
        <tr class="border-b border-slate-50 last:border-0 group">
            <td class="py-4 pr-2">
                <select name="line_product_id[]"
                    class="w-full px-4 py-2 bg-slate-50 border-transparent rounded-xl outline-none focus:bg-white focus:border-emerald-500 border-2 transition-all font-medium">
                    <option value="">เลือกสินค้า</option>
                    <% products.forEach(p=> { %>
                        <option value="<%= p.id %>">
                            <%= p.code %> - <%= p.name %>
                        </option>
                        <% }) %>
                </select>
            </td>
            <td class="py-4 px-2">
                <input type="number" name="line_product_qty[]" value="1" min="1"
                    class="w-full px-4 py-2 bg-slate-50 border-transparent rounded-xl outline-none focus:bg-white focus:border-emerald-500 border-2 transition-all font-medium text-right">
            </td>
            <td class="py-4 pl-2 text-right">
                <button type="button" onclick="this.closest('tr').remove()"
                    class="text-slate-300 hover:text-rose-500 transition-colors">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </td>
        </tr>
    </template>

    <template id="trackRowTemplate">
        <tr class="border-b border-slate-50 last:border-0 group">
            <td class="py-4 pr-2">
                <input type="date" name="track_date[]" value="<%= new Date().toISOString().split('T')[0] %>"
                    class="w-full px-4 py-2 bg-slate-50 border-transparent rounded-xl outline-none focus:bg-white focus:border-emerald-500 border-2 transition-all font-medium">
            </td>
            <td class="py-4 px-2">
                <input type="text" name="track_note[]"
                    class="w-full px-4 py-2 bg-slate-50 border-transparent rounded-xl outline-none focus:bg-white focus:border-emerald-500 border-2 transition-all font-medium">
            </td>
            <td class="py-4 pl-2 text-right">
                <button type="button" onclick="this.closest('tr').remove()"
                    class="text-slate-300 hover:text-rose-500 transition-colors">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </td>
        </tr>
    </template>

    <script>
        function addProductRow() {
            const container = document.getElementById('productContainer');
            const template = document.getElementById('productRowTemplate');
            container.insertAdjacentHTML('beforeend', template.innerHTML);
        }

        function addTrackRow() {
            const container = document.getElementById('trackContainer');
            const template = document.getElementById('trackRowTemplate');
            container.insertAdjacentHTML('beforeend', template.innerHTML);
        }

        // Add initial rows
        document.addEventListener('DOMContentLoaded', () => {
            addProductRow();
            addTrackRow();
        });
    </script>

    <%- include('../partials/layout_end') %>