<%- include('../partials/layout_start') %>

    <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center space-y-4 md:space-y-0">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">Database Backup & Recovery</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการสำรองข้อมูล และส่งออกไปยัง Synology NAS</p>
        </div>
        <form action="/backup/run" method="POST">
            <button type="submit"
                class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-8 rounded-[2rem] shadow-xl shadow-emerald-100 transition-all hover:-translate-y-1 active:scale-95 flex items-center space-x-3">
                <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                <span>เริ่มสำรองข้อมูลทันที</span>
            </button>
        </form>
    </div>

    <% if (msg) { %>
        <div
            class="mb-8 p-6 bg-emerald-50 border border-emerald-100 text-emerald-700 rounded-3xl flex items-center animate-in fade-in slide-in-from-top-4">
            <div class="w-10 h-10 bg-emerald-100 rounded-2xl flex items-center justify-center mr-4">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <span class="font-bold">
                <%= msg %>
            </span>
        </div>
        <% } %>

            <% if (error) { %>
                <div
                    class="mb-8 p-6 bg-rose-50 border border-rose-100 text-rose-700 rounded-3xl flex items-center animate-in fade-in slide-in-from-top-4">
                    <div class="w-10 h-10 bg-rose-100 rounded-2xl flex items-center justify-center mr-4">
                        <i class="fa-solid fa-circle-exclamation"></i>
                    </div>
                    <span class="font-bold">
                        <%= error %>
                    </span>
                </div>
                <% } %>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-20">
                        <!-- Left Column: Settings -->
                        <div class="lg:col-span-4 space-y-8">
                            <!-- Local Scheduling -->
                            <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 p-8">
                                <div class="flex items-center space-x-4 mb-8">
                                    <div
                                        class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600">
                                        <i class="fa-solid fa-calendar-check text-xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-slate-800">Auto Backup</h3>
                                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Local
                                            Scheduling</p>
                                    </div>
                                </div>

                                <form action="/backup/settings" method="POST" id="settingsForm" class="space-y-6">
                                    <!-- Status Toggle -->
                                    <div
                                        class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100">
                                        <span class="text-sm font-bold text-slate-700">เปิดใช้งานอัตโนมัติ</span>
                                        <label class="relative inline-flex items-center cursor-pointer">
                                            <input type="checkbox" name="enabled_toggle" value="true"
                                                class="sr-only peer" <%=config.enabled ? 'checked' : '' %>
                                            onchange="document.getElementById('enabled_hidden').value = this.checked">
                                            <input type="hidden" name="enabled" id="enabled_hidden"
                                                value="<%= config.enabled %>">
                                            <div
                                                class="w-14 h-7 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-500">
                                            </div>
                                        </label>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-3">ช่วงเวลาสำรองข้อมูล
                                            (Cron)</label>
                                        <input type="text" name="schedule" value="<%= config.schedule %>"
                                            class="w-full px-5 py-4 bg-white border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all font-mono text-sm"
                                            placeholder="0 0 * * *">
                                        <div class="mt-4 flex flex-wrap gap-2">
                                            <button type="button" onclick="setCron('0 0 * * *')"
                                                class="px-4 py-2 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 rounded-xl text-[10px] font-black uppercase transition-all">Daily</button>
                                            <button type="button" onclick="setCron('0 0 * * 0')"
                                                class="px-4 py-2 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 rounded-xl text-[10px] font-black uppercase transition-all">Weekly</button>
                                        </div>
                                    </div>

                                    <hr class="border-slate-50">

                                    <!-- NAS Export Section -->
                                    <div class="flex items-center space-x-4 mb-6">
                                        <div
                                            class="w-12 h-12 bg-sky-50 rounded-2xl flex items-center justify-center text-sky-600">
                                            <i class="fa-solid fa-server text-xl"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-slate-800">Synology NAS</h3>
                                            <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest">
                                                Cloud Export</p>
                                        </div>
                                    </div>

                                    <div
                                        class="flex items-center justify-between p-4 bg-sky-50/50 rounded-2xl border border-sky-100">
                                        <span class="text-sm font-bold text-sky-900">ส่งออกไปยัง NAS</span>
                                        <label class="relative inline-flex items-center cursor-pointer">
                                            <input type="checkbox" name="nas_enabled_toggle" value="true"
                                                class="sr-only peer" <%=config.nas_enabled ? 'checked' : '' %>
                                            onchange="document.getElementById('nas_enabled_hidden').value =
                                            this.checked">
                                            <input type="hidden" name="nas_enabled" id="nas_enabled_hidden"
                                                value="<%= config.nas_enabled %>">
                                            <div
                                                class="w-14 h-7 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-sky-500">
                                            </div>
                                        </label>
                                    </div>

                                    <div class="space-y-4">
                                        <div class="grid grid-cols-4 gap-3">
                                            <div class="col-span-3">
                                                <label
                                                    class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Server
                                                    Host</label>
                                                <input type="text" name="nas_host" value="<%= config.nas_host %>"
                                                    class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-sky-500 outline-none"
                                                    placeholder="192.168.1.100">
                                            </div>
                                            <div class="col-span-1">
                                                <label
                                                    class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Port</label>
                                                <input type="number" name="nas_port" value="<%= config.nas_port %>"
                                                    class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-sky-500 outline-none text-center"
                                                    placeholder="22">
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-2 gap-3">
                                            <div>
                                                <label
                                                    class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Username</label>
                                                <input type="text" name="nas_user" value="<%= config.nas_user %>"
                                                    class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-sky-500 outline-none"
                                                    placeholder="nasuser">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">Password</label>
                                                <input type="password" name="nas_pass" value="<%= config.nas_pass %>"
                                                    class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-sky-500 outline-none"
                                                    placeholder="••••••••">
                                            </div>
                                        </div>
                                        <div>
                                            <label
                                                class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5 ml-1">NAS
                                                Destination Path</label>
                                            <input type="text" name="nas_path" value="<%= config.nas_path %>"
                                                class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-sky-500 outline-none font-mono"
                                                placeholder="/volume1/backups">
                                        </div>
                                    </div>

                                    <button type="submit"
                                        class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-5 rounded-[2rem] shadow-2xl transition-all hover:scale-[1.02] active:scale-95 flex items-center justify-center space-x-3 mt-6">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        <span>บันทึกการตั้งค่าทั้งหมด</span>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Right Column: Files -->
                        <div class="lg:col-span-8">
                            <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
                                <div
                                    class="p-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/30">
                                    <h3 class="text-xl font-bold text-slate-800 flex items-center">
                                        <i class="fa-solid fa-list-check mr-4 text-emerald-500"></i>
                                        รายการไฟล์ล่าสุด
                                    </h3>
                                    <div class="flex items-center space-x-3">
                                        <span
                                            class="bg-emerald-100 text-emerald-700 px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-widest ring-1 ring-emerald-200">
                                            <%= files.length %> Backups Total
                                        </span>
                                    </div>
                                </div>

                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead class="bg-slate-50/50 border-b border-slate-100">
                                            <tr>
                                                <th
                                                    class="px-8 py-5 text-slate-400 font-black text-[10px] uppercase tracking-[0.2em]">
                                                    File Information</th>
                                                <th
                                                    class="px-4 py-5 text-slate-400 font-black text-[10px] uppercase tracking-[0.2em]">
                                                    Data Size</th>
                                                <th
                                                    class="px-4 py-5 text-slate-400 font-black text-[10px] uppercase tracking-[0.2em]">
                                                    Timestamp</th>
                                                <th
                                                    class="px-8 py-5 text-right text-slate-400 font-black text-[10px] uppercase tracking-[0.2em]">
                                                    Commands</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            <% if (files.length===0) { %>
                                                <tr>
                                                    <td colspan="4" class="px-8 py-32 text-center">
                                                        <div class="flex flex-col items-center">
                                                            <div
                                                                class="w-24 h-24 bg-slate-50 rounded-[2.5rem] flex items-center justify-center text-slate-200 mb-6">
                                                                <i class="fa-solid fa-folder-open text-5xl"></i>
                                                            </div>
                                                            <p class="text-xl font-bold text-slate-300">No backup
                                                                records found</p>
                                                            <p class="text-sm text-slate-400 mt-2">Initialize your first
                                                                backup manually above.</p>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% } %>
                                                    <% files.forEach(file=> { %>
                                                        <tr
                                                            class="group hover:bg-slate-50/50 transition-all duration-300">
                                                            <td class="px-8 py-6">
                                                                <div class="flex items-center space-x-5">
                                                                    <div
                                                                        class="w-12 h-12 bg-white border border-slate-100 rounded-2xl shadow-sm flex items-center justify-center text-slate-400 group-hover:text-amber-500 group-hover:border-amber-100 transition-all">
                                                                        <i class="fa-solid fa-database text-lg"></i>
                                                                    </div>
                                                                    <div>
                                                                        <span
                                                                            class="block font-bold text-slate-700 group-hover:text-emerald-700 transition-colors">
                                                                            <%= file.name %>
                                                                        </span>
                                                                        <span
                                                                            class="text-[10px] text-slate-400 font-medium font-mono">SQL
                                                                            Format</span>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="px-4 py-6">
                                                                <span
                                                                    class="inline-flex items-center px-3 py-1 bg-slate-100 text-slate-600 rounded-lg text-xs font-bold font-mono">
                                                                    <%= (file.size / 1024 / 1024).toFixed(2) %> MB
                                                                </span>
                                                            </td>
                                                            <td class="px-4 py-6">
                                                                <div class="flex flex-col">
                                                                    <span class="text-sm font-bold text-slate-600">
                                                                        <%= new
                                                                            Date(file.date).toLocaleDateString('th-TH')
                                                                            %>
                                                                    </span>
                                                                    <span class="text-[10px] text-slate-400">
                                                                        <%= new
                                                                            Date(file.date).toLocaleTimeString('th-TH')
                                                                            %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td class="px-8 py-6 text-right">
                                                                <div class="flex justify-end space-x-3">
                                                                    <a href="/backup/download/<%= file.name %>"
                                                                        class="w-12 h-12 flex items-center justify-center rounded-[1.2rem] bg-white border border-slate-200 text-slate-400 hover:text-emerald-600 hover:border-emerald-200 hover:bg-emerald-50 hover:-translate-y-1 transition-all"
                                                                        title="Download Backup">
                                                                        <i class="fa-solid fa-download"></i>
                                                                    </a>
                                                                    <button onclick="confirmDelete('<%= file.name %>')"
                                                                        class="w-12 h-12 flex items-center justify-center rounded-[1.2rem] bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 hover:-translate-y-1 transition-all"
                                                                        title="Delete Permanent">
                                                                        <i class="fa-solid fa-trash-can"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="p-8 bg-slate-50/50 border-t border-slate-100">
                                    <div class="flex items-center space-x-2 text-slate-400">
                                        <i class="fa-solid fa-circle-info text-xs"></i>
                                        <p class="text-[10px] font-bold uppercase tracking-widest">Files are stored
                                            locally in /uploads/backup and synced to Synology if configured.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <script>
                        function setCron(val) {
                            document.querySelector('input[name="schedule"]').value = val;
                        }

                        function confirmDelete(name) {
                            if (confirm('ระบบจะลบไฟล์ "' + name + '" แบบถาวร คุณแน่ใจหรือไม่?')) {
                                window.location.href = '/backup/delete/' + name;
                            }
                        }
                    </script>

                    <style>
                        .font-mono {
                            font-family: 'JetBrains Mono', 'Courier New', monospace;
                        }
                    </style>

                    <%- include('../partials/layout_end') %>