<%- include('../partials/layout_start') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">นับสต๊อก</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการการนับสต๊อกสินค้าในคลัง</p>
        </div>
        <button onclick="openAddModal()"
            class="flex items-center justify-center space-x-2 bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-2xl shadow-lg shadow-purple-200 transition-all active:scale-95 font-bold">
            <i class="fa-solid fa-plus text-sm"></i>
            <span>สร้างรายการนับสต๊อก</span>
        </button>
    </div>

    <div class="bg-white rounded-[2rem] shadow-sm border border-purple-50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-purple-50/50">
                        <th class="px-6 py-5 text-purple-800 font-bold text-sm uppercase tracking-wider">เลขที่เอกสาร
                        </th>
                        <th class="px-6 py-5 text-purple-800 font-bold text-sm uppercase tracking-wider">วันที่นับสต๊อก
                        </th>
                        <th class="px-6 py-5 text-purple-800 font-bold text-sm uppercase tracking-wider text-center">
                            สถานะ</th>
                        <th class="px-6 py-5 text-purple-800 font-bold text-sm uppercase tracking-wider text-right">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-purple-50">
                    <% counts.forEach(count=> { %>
                        <tr class="hover:bg-purple-50/30 transition-colors group">
                            <td class="px-6 py-5">
                                <span
                                    class="bg-purple-100 text-purple-700 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-purple-200">
                                    <%= count.journal_no || '-' %>
                                </span>
                            </td>
                            <td class="px-6 py-5 text-slate-600">
                                <%= count.trans_date ? new Date(count.trans_date).toLocaleDateString('th-TH', {
                                    year: 'numeric' , month: 'long' , day: 'numeric' , weekday: 'short' }) : '-' %>
                            </td>
                            <td class="px-6 py-5 text-center">
                                <% if (count.status===1) { %>
                                    <span
                                        class="bg-green-100 text-green-700 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-green-200">
                                        <i class="fa-solid fa-check-circle mr-1"></i>
                                        เสร็จสิ้น
                                    </span>
                                    <% } else if (count.status===0) { %>
                                        <span
                                            class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-yellow-200">
                                            <i class="fa-solid fa-clock mr-1"></i>
                                            รอดำเนินการ
                                        </span>
                                        <% } else { %>
                                            <span
                                                class="bg-gray-100 text-gray-700 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-gray-200">
                                                ไม่ระบุ
                                            </span>
                                            <% } %>
                            </td>
                            <td class="px-6 py-5 text-right">
                                <div
                                    class="flex justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <a href="/stock-count/view/<%= count.id %>"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-purple-600 hover:border-purple-200 hover:bg-purple-50 transition-all">
                                        <i class="fa-solid fa-eye text-sm"></i>
                                    </a>
                                    <a href="/stock-count/delete/<%= count.id %>"
                                        onclick="return confirm('ยืนยันการลบข้อมูล?')"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (counts.length===0) { %>
                                <tr>
                                    <td colspan="4" class="px-6 py-20 text-center text-slate-400">
                                        <i class="fa-solid fa-clipboard-list text-5xl mb-4 opacity-20 block"></i>
                                        <span class="font-medium">ไม่พบข้อมูลการนับสต๊อก</span>
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <%- include('../partials/pagination') %>
    </div>

    <!-- Add Modal -->
    <div id="modal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
        <div
            class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-8 border-b border-slate-50 flex justify-between items-center">
                <h3 id="modalTitle" class="text-2xl font-black text-slate-800">สร้างรายการนับสต๊อก</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <form id="modalForm" method="POST" action="/stock-count/add" class="p-8 space-y-6">
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 ml-1">เลขที่เอกสาร</label>
                    <input type="text" name="journal_no" id="journalNo" required
                        class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-purple-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                        placeholder="เช่น SC-001">
                </div>
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 ml-1">วันที่นับสต๊อก</label>
                    <input type="date" name="trans_date" id="transDate" required
                        class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-purple-500 focus:bg-white rounded-2xl outline-none transition-all font-medium">
                </div>
                <div class="flex space-x-4 pt-4">
                    <button type="button" onclick="closeModal()"
                        class="flex-1 px-8 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold transition-colors">ยกเลิก</button>
                    <button type="submit"
                        class="flex-1 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-2xl font-bold shadow-lg shadow-purple-100 transition-all active:scale-95">สร้างรายการ</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('modal');
        const modalTitle = document.getElementById('modalTitle');
        const modalForm = document.getElementById('modalForm');

        function openAddModal() {
            modalTitle.innerText = 'สร้างรายการนับสต๊อก';
            modalForm.action = '/stock-count/add';
            document.getElementById('journalNo').value = '';
            document.getElementById('transDate').value = new Date().toISOString().split('T')[0];
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
        }
    </script>

    <%- include('../partials/layout_end') %>