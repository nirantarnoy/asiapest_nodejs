<%- include('../partials/layout_start') %>

    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
        <div
            class="w-32 h-32 bg-rose-50 rounded-full flex items-center justify-center text-rose-500 mb-8 animate-bounce">
            <i class="fa-solid fa-lock text-5xl"></i>
        </div>

        <h1 class="text-4xl font-black text-slate-800 mb-4">เข้าถึงไม่ได้ (403 Forbidden)</h1>
        <p class="text-slate-500 text-lg mb-8 max-w-md">
            ขออภัย คุณไม่มีสิทธิ์เข้าถึงหน้านี้ <br>
            <span class="font-bold text-rose-600">สิทธิ์ที่ต้องการ: <%= permissionName %></span>
        </p>

        <div class="flex space-x-4">
            <a href="/dashboard"
                class="px-8 py-4 bg-indigo-600 text-white font-bold rounded-2xl shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition-all active:scale-95">
                กลับหน้าหลัก
            </a>
            <button onclick="history.back()"
                class="px-8 py-4 bg-slate-100 text-slate-600 font-bold rounded-2xl hover:bg-slate-200 transition-all">
                ย้อนกลับ
            </button>
        </div>
    </div>

    <%- include('../partials/layout_end') %>