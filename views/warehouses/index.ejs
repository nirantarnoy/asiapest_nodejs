<%- include('../partials/layout_start') %>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">คลังสินค้า</h1>
            <p class="text-slate-500 mt-1 font-medium">จัดการข้อมูลคลังสินค้าในระบบ</p>
        </div>
        <button onclick="openAddModal()"
            class="flex items-center justify-center space-x-2 bg-teal-600 hover:bg-teal-700 text-white px-6 py-3 rounded-2xl shadow-lg shadow-teal-200 transition-all active:scale-95 font-bold">
            <i class="fa-solid fa-plus text-sm"></i>
            <span>เพิ่มคลังสินค้า</span>
        </button>
    </div>

    <div class="bg-white rounded-[2rem] shadow-sm border border-teal-50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-teal-50/50">
                        <th class="px-6 py-5 text-teal-800 font-bold text-sm uppercase tracking-wider">รหัส</th>
                        <th class="px-6 py-5 text-teal-800 font-bold text-sm uppercase tracking-wider">ชื่อคลังสินค้า
                        </th>
                        <th class="px-6 py-5 text-teal-800 font-bold text-sm uppercase tracking-wider">รายละเอียด
                        </th>
                        <th class="px-6 py-5 text-teal-800 font-bold text-sm uppercase tracking-wider text-right">
                            จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-teal-50">
                    <% items.forEach(item=> { %>
                        <tr class="hover:bg-teal-50/30 transition-colors group">
                            <td class="px-6 py-5">
                                <span
                                    class="bg-teal-100 text-teal-700 px-3 py-1 rounded-lg text-xs font-bold ring-1 ring-teal-200">
                                    <%= item.code %>
                                </span>
                            </td>
                            <td class="px-6 py-5 font-bold text-slate-700">
                                <%= item.name %>
                            </td>
                            <td class="px-6 py-5 text-slate-500 text-sm">
                                <%= item.description || '-' %>
                            </td>
                            <td class="px-6 py-5 text-right">
                                <div
                                    class="flex justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button onclick='openEditModal(<%- JSON.stringify(item) %>)'
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-teal-600 hover:border-teal-200 hover:bg-teal-50 transition-all">
                                        <i class="fa-solid fa-pen-to-square text-sm"></i>
                                    </button>
                                    <a href="/warehouses/delete/<%= item.id %>"
                                        onclick="return confirm('ยืนยันการลบข้อมูล?')"
                                        class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-200 hover:bg-rose-50 transition-all">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (items.length===0) { %>
                                <tr>
                                    <td colspan="4" class="px-6 py-20 text-center text-slate-400">
                                        <i class="fa-solid fa-folder-open text-5xl mb-4 opacity-20 block"></i>
                                        <span class="font-medium">ไม่พบข้อมูลคลังสินค้า</span>
                                    </td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <%- include('../partials/pagination') %>
    </div>

    <!-- Add/Edit Modal -->
    <div id="modal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
        <div
            class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-8 border-b border-slate-50 flex justify-between items-center">
                <h3 id="modalTitle" class="text-2xl font-black text-slate-800">เพิ่มคลังสินค้า</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <form id="modalForm" method="POST" action="/warehouses/add" class="p-8 space-y-6">
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 ml-1">รหัสคลังสินค้า</label>
                    <input type="text" name="code" id="itemCode" required
                        class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-teal-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                        placeholder="เช่น WH-001">
                </div>
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 ml-1">ชื่อคลังสินค้า</label>
                    <input type="text" name="name" id="itemName" required
                        class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-teal-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                        placeholder="ชื่อคลังสินค้า">
                </div>
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 ml-1">รายละเอียด</label>
                    <textarea name="description" id="itemDescription" rows="3"
                        class="w-full px-5 py-4 bg-slate-50 border-2 border-transparent focus:border-teal-500 focus:bg-white rounded-2xl outline-none transition-all font-medium"
                        placeholder="รายละเอียดเพิ่มเติม"></textarea>
                </div>
                <div class="flex space-x-4 pt-4">
                    <button type="button" onclick="closeModal()"
                        class="flex-1 px-8 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold transition-colors">ยกเลิก</button>
                    <button type="submit"
                        class="flex-1 px-8 py-4 bg-teal-600 hover:bg-teal-700 text-white rounded-2xl font-bold shadow-lg shadow-teal-100 transition-all active:scale-95">บันทึกข้อมูล</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const modal = document.getElementById('modal');
        const modalTitle = document.getElementById('modalTitle');
        const modalForm = document.getElementById('modalForm');

        function openAddModal() {
            modalTitle.innerText = 'เพิ่มคลังสินค้า';
            modalForm.action = '/warehouses/add';
            document.getElementById('itemCode').value = '';
            document.getElementById('itemName').value = '';
            document.getElementById('itemDescription').value = '';
            modal.classList.remove('hidden');
        }

        function openEditModal(item) {
            modalTitle.innerText = 'แก้ไขคลังสินค้า';
            modalForm.action = `/warehouses/edit/${item.id}`;
            document.getElementById('itemCode').value = item.code;
            document.getElementById('itemName').value = item.name;
            document.getElementById('itemDescription').value = item.description || '';
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
        }
    </script>

    <%- include('../partials/layout_end') %>