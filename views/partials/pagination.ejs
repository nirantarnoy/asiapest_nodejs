<% if (pagination.total> 0) { %>
    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/30">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <!-- Left: Items per page selector -->
            <div class="flex items-center space-x-3">
                <span class="text-sm text-slate-600 font-medium">แสดง:</span>
                <select onchange="changeLimit(this.value)"
                    class="px-4 py-2 bg-white border-2 border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:border-emerald-500 focus:outline-none transition-colors">
                    <option value="20" <%=pagination.limit==20 ? 'selected' : '' %>>20 รายการ</option>
                    <option value="50" <%=pagination.limit==50 ? 'selected' : '' %>>50 รายการ</option>
                    <option value="100" <%=pagination.limit==100 ? 'selected' : '' %>>100 รายการ</option>
                    <option value="all" <%=pagination.limit=='all' ? 'selected' : '' %>>ทั้งหมด</option>
                </select>
                <span class="text-sm text-slate-500">
                    <% if (pagination.limit==='all' ) { %>
                        แสดง <%= pagination.total %> รายการ
                            <% } else { %>
                                แสดง <%= ((pagination.page - 1) * pagination.limit) + 1 %>-<%= Math.min(pagination.page
                                        * pagination.limit, pagination.total) %>
                                        จาก <%= pagination.total %> รายการ
                                            <% } %>
                </span>
            </div>

            <!-- Right: Pagination buttons -->
            <% if (pagination.limit !=='all' && pagination.totalPages> 1) { %>
                <div class="flex items-center space-x-2">
                    <!-- Previous button -->
                    <% if (pagination.page> 1) { %>
                        <a href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>"
                            class="px-4 py-2 bg-white border-2 border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-emerald-50 hover:border-emerald-500 hover:text-emerald-600 transition-all">
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                            <span class="ml-2 hidden sm:inline">ก่อนหน้า</span>
                        </a>
                        <% } else { %>
                            <span
                                class="px-4 py-2 bg-slate-100 border-2 border-slate-200 rounded-xl text-sm font-bold text-slate-400 cursor-not-allowed">
                                <i class="fa-solid fa-chevron-left text-xs"></i>
                                <span class="ml-2 hidden sm:inline">ก่อนหน้า</span>
                            </span>
                            <% } %>

                                <!-- Page numbers -->
                                <div class="hidden md:flex items-center space-x-1">
                                    <% const maxVisible=5; let startPage=Math.max(1, pagination.page -
                                        Math.floor(maxVisible / 2)); let endPage=Math.min(pagination.totalPages,
                                        startPage + maxVisible - 1); if (endPage - startPage < maxVisible - 1) {
                                        startPage=Math.max(1, endPage - maxVisible + 1); } if (startPage> 1) { %>
                                        <a href="?page=1&limit=<%= pagination.limit %>"
                                            class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition-all">
                                            1
                                        </a>
                                        <% if (startPage> 2) { %>
                                            <span class="px-2 text-slate-400">...</span>
                                            <% } %>
                                                <% } %>

                                                    <% for (let i=startPage; i <=endPage; i++) { %>
                                                        <% if (i===pagination.page) { %>
                                                            <span
                                                                class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold bg-emerald-600 text-white shadow-lg shadow-emerald-200">
                                                                <%= i %>
                                                            </span>
                                                            <% } else { %>
                                                                <a href="?page=<%= i %>&limit=<%= pagination.limit %>"
                                                                    class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition-all">
                                                                    <%= i %>
                                                                </a>
                                                                <% } %>
                                                                    <% } %>

                                                                        <% if (endPage < pagination.totalPages) { %>
                                                                            <% if (endPage < pagination.totalPages - 1)
                                                                                { %>
                                                                                <span
                                                                                    class="px-2 text-slate-400">...</span>
                                                                                <% } %>
                                                                                    <a href="?page=<%= pagination.totalPages %>&limit=<%= pagination.limit %>"
                                                                                        class="w-10 h-10 flex items-center justify-center rounded-xl text-sm font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition-all">
                                                                                        <%= pagination.totalPages %>
                                                                                    </a>
                                                                                    <% } %>
                                </div>

                                <!-- Mobile page indicator -->
                                <div
                                    class="md:hidden px-4 py-2 bg-white border-2 border-slate-200 rounded-xl text-sm font-bold text-slate-700">
                                    หน้า <%= pagination.page %> / <%= pagination.totalPages %>
                                </div>

                                <!-- Next button -->
                                <% if (pagination.page < pagination.totalPages) { %>
                                    <a href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>"
                                        class="px-4 py-2 bg-white border-2 border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-emerald-50 hover:border-emerald-500 hover:text-emerald-600 transition-all">
                                        <span class="mr-2 hidden sm:inline">ถัดไป</span>
                                        <i class="fa-solid fa-chevron-right text-xs"></i>
                                    </a>
                                    <% } else { %>
                                        <span
                                            class="px-4 py-2 bg-slate-100 border-2 border-slate-200 rounded-xl text-sm font-bold text-slate-400 cursor-not-allowed">
                                            <span class="mr-2 hidden sm:inline">ถัดไป</span>
                                            <i class="fa-solid fa-chevron-right text-xs"></i>
                                        </span>
                                        <% } %>
                </div>
                <% } %>
        </div>
    </div>

    <script>
        function changeLimit(limit) {
            const url = new URL(window.location);
            url.searchParams.set('limit', limit);
            url.searchParams.set('page', '1'); // Reset to first page when changing limit
            window.location.href = url.toString();
        }
    </script>
    <% } %>